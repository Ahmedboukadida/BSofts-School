# ==============================================================================
# BSofts-School — Docker Environment Configuration Template
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=bsofts_school
POSTGRES_PORT=5432

# Cache (Redis 7)
REDIS_PORT=6379

# Backend Configuration
PORT=3025
NODE_ENV=production
JWT_SECRET=generate_a_minimum_32_char_random_jwt_secret_here
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3025/api
