// ============================================================
// MESSAGING & NOTIFICATIONS
// ============================================================

enum ConversationType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum NotificationType {
  IN_APP
  EMAIL
  SMS
}

model Conversation {
  id        String           @id @default(uuid())
  title     String?
  type      ConversationType @default(DIRECT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("Sender", fields: [senderId], references: [id])
  receiverId     String?
  receiver       User?        @relation("Receiver", fields: [receiverId], references: [id])
  content        String
  type           MessageType  @default(TEXT)
  fileUrl        String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([userId])
}

model NotificationTemplate {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  subject   String?
  body      String
  type      NotificationType
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ============================================================
// AUDIT & GRADUATION
// ============================================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  actorSnapshot String? // Denormalized snapshot: "FirstName LastName (@username) [ROLE]"
  action        String
  entity        String
  entityId      String?
  status        String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([status])
}

model SystemLog {
  id         String   @id @default(uuid())
  level      String // "ERROR" | "WARN" | "FATAL" | "INFO"
  message    String
  stack      String?
  context    String?
  path       String?
  method     String?
  statusCode Int?
  userId     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([statusCode])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // "THEME", "CURRENCY", "SMTP", "SECURITY"
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model GraduationConfig {
  id               String        @id @default(uuid())
  establishmentId  String
  establishment    Establishment @relation(fields: [establishmentId], references: [id])
  classId          String
  class            Class         @relation(fields: [classId], references: [id])
  minAverageToPass Decimal       @default(10) @db.Decimal(5, 2)
  autoPromote      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([establishmentId, classId])
}

model GraduationRecord {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  fromClassId    String
  fromClass      Class        @relation("FromClass", fields: [fromClassId], references: [id])
  toClassId      String?
  toClass        Class?       @relation("ToClass", fields: [toClassId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  averageScore   Decimal      @db.Decimal(5, 2)
  isPromoted     Boolean
  reason         String?
  processedBy    String?
  processedAt    DateTime     @default(now())

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([fromClassId])
  @@index([academicYearId])
}

model DynamicEnum {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category        String // e.g. "STUDENT_STATUS", "DISCIPLINE_NATURE", "PAYMENT_METHOD", "CAISSE_TYPE"
  code            String // unique identifier key within establishment and category
  labelFr         String
  labelEn         String
  labelAr         String
  color           String?       @default("#4F46E5")
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, category, code])
  @@index([establishmentId, category])
}

