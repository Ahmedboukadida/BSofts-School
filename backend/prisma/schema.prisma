  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  REFUNDED
}

enum CaisseType {
  MAIN
  TUITION
  SALARY
  PETTY_CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
