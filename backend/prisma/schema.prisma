  @@index([classId])
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  HOMEWORK
  PRACTICAL
  OTHER
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  GRADED
}

