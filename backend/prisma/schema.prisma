generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SAAS PLATFORM
// ============================================================

enum PlanInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum Currency {
  TND
  EUR
  USD
  DZD
}

enum Language {
  FR
  EN
  AR
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model SaaSPlan {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  price       Decimal      @db.Decimal(10, 2)
  currency    Currency     @default(TND)
  interval    PlanInterval
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  modules       SaaSPlanModule[]
  features      SaaSPlanFeature[]
  subscriptions TenantSubscription[]
}

model SaaSModule {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  plans       SaaSPlanModule[]
  permissions SaaSPermission[]
}

model SaaSPermission {
  id          String     @id @default(uuid())
  moduleId    String
  module      SaaSModule @relation(fields: [moduleId], references: [id])
  name        String
  code        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  rolePermissions RolePermission[]
}

model SaaSPlanModule {
  planId   String
  plan     SaaSPlan   @relation(fields: [planId], references: [id])
  moduleId String
  module   SaaSModule @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())

  @@id([planId, moduleId])
}

model SaaSPlanFeature {
  id          String   @id @default(uuid())
  planId      String
  plan        SaaSPlan @relation(fields: [planId], references: [id])
  code        String
  value       String
  description String?
  createdAt   DateTime @default(now())

  @@unique([planId, code])
}

model TenantSubscription {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  planId    String
  plan      SaaSPlan           @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId])
}

model TenantPlanFeatureOverride {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  featureCode String
  value       String
  createdAt   DateTime @default(now())

  @@unique([tenantId, featureCode])
}

// ============================================================
// TENANTS & ESTABLISHMENTS
// ============================================================

enum EstablishmentCategory {
  DAYCARE
  SCHOOL
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  UNIVERSITY
}

model Tenant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  settings             TenantSettings?
  establishments       Establishment[]
  subscriptions        TenantSubscription[]
  planFeatureOverrides TenantPlanFeatureOverride[]
}

model TenantSettings {
  id         String   @id @default(uuid())
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  currency   Currency @default(TND)
  language   Language @default(FR)
  theme      Theme    @default(LIGHT)
  timezone   String   @default("Africa/Tunis")
  dateFormat String   @default("DD/MM/YYYY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
}

model Establishment {
  id        String                @id @default(uuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  name      String
  slug      String                @unique
  category  EstablishmentCategory
  country   String                @default("TN")
  timezone  String                @default("Africa/Tunis")
  logo      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  configs             EstablishmentConfig[]
  academicYears       AcademicYear[]
  classes             Class[]
  academicModules     AcademicModule[]
  rooms               Room[]
  holidays            Holiday[]
  smtpConfigs         SmtpConfig[]
  notificationConfigs NotificationConfig[]
  paymentConfigs      PaymentConfig[]
  gradingConfigs      GradingConfig[]
  students            Student[]
  teachers            Teacher[]
  employees           Employee[]
  parents             Parent[]
  paymentPlans        PaymentPlan[]
  caisses             Caisse[]
  exams               Exam[]
  userRoles           UserRoleAssignment[]
  profitLosses        ProfitLoss[]
  graduationConfigs   GraduationConfig[]
  dynamicEnums        DynamicEnum[]
  meetings            Meeting[]

  @@index([tenantId])
}

// ============================================================
// USERS & AUTH
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  username    String?   @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  isActive    Boolean   @default(true)
  isRoot      Boolean   @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  tenant                   Tenant?
  userRoles                UserRoleAssignment[]
  auditLogs                AuditLog[]
  loginLogs                LoginLog[]
  sentMessages             Message[]                 @relation("Sender")
  receivedMessages         Message[]                 @relation("Receiver")
  notifications            Notification[]
  student                  Student?
  parent                   Parent?
  teacher                  Teacher?
  employee                 Employee?
  conversationParticipants ConversationParticipant[]
  createdMeetings          Meeting[]                 @relation("MeetingCreator")
  meetingParticipants      MeetingParticipant[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]
}

model UserRoleAssignment {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([userId, roleId, establishmentId])
  @@index([userId])
  @@index([roleId])
  @@index([establishmentId])
}

model RolePermission {
  id           String         @id @default(uuid())
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  permissionId String
  permission   SaaSPermission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime       @default(now())

  @@unique([roleId, permissionId])
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// ESTABLISHMENT CONFIGURATION
// ============================================================

enum GradingScaleType {
  NUMERIC
  LETTER
  PERCENTAGE
  CUSTOM
}

enum PeriodType {
  TRIMESTER
  SEMESTER
}

enum PaymentMethod {
  CASH
  CHECK
  STRIPE
  PAYPAL
  VISA
  MASTERCARD
  AMERICAN_EXPRESS
  BANK_TRANSFER
}

enum ContractType {
  HOURLY
  MONTHLY
  YEARLY
  PER_FORMATION
  PER_SESSION
  CUSTOM
}

model EstablishmentConfig {
  id                      String        @id @default(uuid())
  establishmentId         String        @unique
  establishment           Establishment @relation(fields: [establishmentId], references: [id])
  defaultLanguage         String        @default("fr")
  defaultCurrency         String        @default("DZD")
  academicYearStart       Month         @default(SEPTEMBER)
  maxAbsencesBeforeNotify Int           @default(3)
  allowOnlineExams        Boolean       @default(false)
  enableAntiCheating      Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
}

model GradingConfig {
  id              String           @id @default(uuid())
  establishmentId String
  establishment   Establishment    @relation(fields: [establishmentId], references: [id])
  classLevelId    String?
  name            String
  scaleType       GradingScaleType
  minScore        Decimal          @default(0) @db.Decimal(5, 2)
  maxScore        Decimal          @default(20) @db.Decimal(5, 2)
  passThreshold   Decimal          @default(10) @db.Decimal(5, 2)
  gradeLabels     Json?
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  classes Class[]

  @@index([establishmentId])
}

model SmtpConfig {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  host            String
  port            Int
  user            String
  password        String
  fromName        String
  fromEmail       String
  isSecure        Boolean       @default(true)
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([establishmentId])
}

model NotificationConfig {
  id                  String        @id @default(uuid())
  establishmentId     String        @unique
  establishment       Establishment @relation(fields: [establishmentId], references: [id])
  enableEmail         Boolean       @default(true)
  enableInApp         Boolean       @default(true)
  absenceThreshold    Int           @default(3)
  paymentReminderDays Int           @default(7)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
}

model PaymentConfig {
  id                 String          @id @default(uuid())
  establishmentId    String
  establishment      Establishment   @relation(fields: [establishmentId], references: [id])
  allowedMethods     PaymentMethod[]
  stripeKey          String?
  stripeSecret       String?
  paypalClientId     String?
  paypalSecret       String?
  latePenaltyPercent Decimal?        @db.Decimal(5, 2)
  latePenaltyEnabled Boolean         @default(false)
  blockAccessOnLate  Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([establishmentId])
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model AcademicYear {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  startDate       DateTime
  endDate         DateTime
  isCurrent       Boolean       @default(false)
  isClosed        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  periods                 AcademicPeriod[]
  classes                 Class[]
  studentClassAssignments StudentClassAssignment[]
  notes                   Note[]
  exams                   Exam[]
  sessions                Session[]
  graduationRecords       GraduationRecord[]

  @@unique([establishmentId, name])
  @@index([establishmentId])
}

model AcademicPeriod {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  type           PeriodType
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  notes          Note[]
  exams          Exam[]
  sessions       Session[]
  classSchedules ClassSchedule[]
  bulletins      Bulletin[]

  @@index([academicYearId])
}

model ClassLevel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  classes Class[]
}

model Class {
  id              String         @id @default(uuid())
  establishmentId String
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  classLevelId    String
  classLevel      ClassLevel     @relation(fields: [classLevelId], references: [id])
  academicYearId  String
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id])
  gradingConfigId String?
  gradingConfig   GradingConfig? @relation(fields: [gradingConfigId], references: [id])
  name            String
  code            String?
  periodType      PeriodType
  maxStudents     Int            @default(30)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  schedules               ClassSchedule[]
  sessions                Session[]
  studentClassAssignments StudentClassAssignment[]
  exams                   Exam[]
  moduleAssignments       ClassModuleAssignment[]
  graduationRecordsFrom   GraduationRecord[]       @relation("FromClass")
  graduationRecordsTo     GraduationRecord[]       @relation("ToClass")
  bulletins               Bulletin[]
  graduationConfigs       GraduationConfig[]

  @@unique([establishmentId, academicYearId, name])
  @@index([establishmentId])
  @@index([academicYearId])
  @@index([classLevelId])
  @@index([code])
}

model ClassModuleAssignment {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id])
  moduleId  String
  module    AcademicModule @relation(fields: [moduleId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([classId, moduleId])
}

model AcademicModule {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  code            String?
  description     String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  matieres         Matiere[]
  classAssignments ClassModuleAssignment[]

  @@index([establishmentId])
}

model Matiere {
  id          String         @id @default(uuid())
  moduleId    String
  module      AcademicModule @relation(fields: [moduleId], references: [id])
  name        String
  code        String?
  coefficient Decimal        @default(1.0) @db.Decimal(3, 1)
  maxScore    Decimal        @default(20) @db.Decimal(5, 2)
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  lessons         Lesson[]
  notes           Note[]
  exams           Exam[]
  teacherMatieres TeacherMatiere[]
  classSchedules  ClassSchedule[]

  @@index([moduleId])
}

// ============================================================
// PEOPLE: STUDENTS, PARENTS, TEACHERS, EMPLOYEES
// ============================================================

model Student {
  id                 String        @id @default(uuid())
  establishmentId    String
  establishment      Establishment @relation(fields: [establishmentId], references: [id])
  userId             String?       @unique
  user               User?         @relation(fields: [userId], references: [id])
  firstName          String
  lastName           String
  bio                String?
  dateOfBirth        DateTime?
  gender             Gender?
  phone              String?
  address            String?
  photo              String?
  registrationNumber String        @unique
  isActive           Boolean       @default(true)
  enrollmentDate     DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  classAssignments  StudentClassAssignment[]
  attendances       StudentAttendance[]
  notes             Note[]
  bulletins         Bulletin[]
  payments          StudentPayment[]
  parents           StudentParent[]
  examSubmissions   ExamSubmission[]
  graduationRecords GraduationRecord[]

  @@index([establishmentId])
  @@index([registrationNumber])
}

model Parent {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  phone           String?
  email           String?
  address         String?
  occupation      String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  students StudentParent[]
  payments StudentPayment[]

  @@index([establishmentId])
}

model StudentParent {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  relation  String   @default("parent")
  createdAt DateTime @default(now())

  @@unique([studentId, parentId])
}

model StudentClassAssignment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  isPromoted     Boolean?
  assignedAt     DateTime     @default(now())

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
}

model Teacher {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  bio             String?
  phone           String?
  email           String?
  address         String?
  photo           String?
  specialization  String?
  hireDate        DateTime      @default(now())
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  contracts   TeacherContract[]
  attendances TeacherAttendance[]
  matieres    TeacherMatiere[]
  sessions    Session[]
  leaves      TeacherLeave[]
  schedules   ClassSchedule[]
  payments    TeacherPayment[]

  @@index([establishmentId])
}

model TeacherMatiere {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  matiereId String
  matiere   Matiere  @relation(fields: [matiereId], references: [id])
  createdAt DateTime @default(now())

  @@unique([teacherId, matiereId])
}

model TeacherContract {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  contractType   ContractType
  startDate      DateTime
  endDate        DateTime?
  salary         Decimal      @db.Decimal(10, 2)
  currency       String       @default("DZD")
  hourlyRate     Decimal?     @db.Decimal(10, 2)
  monthlyHours   Int?
  paymentFormula Json?
  isActive       Boolean      @default(true)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  payments TeacherPayment[]

  @@index([teacherId])
}

model Employee {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  bio             String?
  phone           String?
  email           String?
  address         String?
  position        String
  hireDate        DateTime      @default(now())
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  contracts EmployeeContract[]

  @@index([establishmentId])
}

model EmployeeContract {
  id          String       @id @default(uuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  type        ContractType
  startDate   DateTime
  endDate     DateTime?
  salary      Decimal      @db.Decimal(10, 2)
  currency    String       @default("DZD")
  isActive    Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Audit & Soft-Delete
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([employeeId])
}

// ============================================================
// ROOMS
// ============================================================

enum RoomType {
  CLASSROOM
  LABORATORY
  LIBRARY
