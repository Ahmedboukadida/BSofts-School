model ExamQuestion {
  id        String       @id @default(uuid())
  examId    String
  exam      Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      QuestionType
  content   String
  options   Json?
  maxScore  Decimal      @db.Decimal(5, 2)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  answers ExamAnswer[]

  @@index([examId])
}

model ExamSubmission {
  id          String           @id @default(uuid())
  examId      String
  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  totalScore  Decimal?         @db.Decimal(5, 2)
  status      SubmissionStatus @default(IN_PROGRESS)
  ipAddress   String?
  tabSwitches Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
}

model ExamAnswer {
  id           String         @id @default(uuid())
  submissionId String
  submission   ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     ExamQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String?
  fileUrl      String?
  score        Decimal?       @db.Decimal(5, 2)
  isCorrect    Boolean?
  createdAt    DateTime       @default(now())

  @@index([submissionId])
  @@index([questionId])
}

