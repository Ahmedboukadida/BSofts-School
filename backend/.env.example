# ============================================================
# BSOFTS-SCHOOL - BACKEND ENVIRONMENT VARIABLES
# ============================================================

# Database Connection (Neon Serverless or Local PostgreSQL)
# Local Dev:  "postgresql://postgres:admin@127.0.0.1:5432/bsoftsschool?schema=public"
# Production: "postgresql://neondb_owner:PASSWORD@ep-ENDPOINT-pooler.us-east-2.aws.neon.tech/bsofts_school?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://postgres:admin@127.0.0.1:5432/bsoftsschool?schema=public"

# JWT Authentication
JWT_SECRET="bsofts-school-jwt-secret-2026-production-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server Configuration
PORT=3025
NODE_ENV="development"

# Frontend & CORS Configuration
# Local Dev:  "http://localhost:3026"
# Production: "https://bsoft-school-front.vercel.app"
FRONTEND_URL="http://localhost:3026"
CORS_ORIGIN="http://localhost:3026,https://bsoft-school-front.vercel.app"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Transactional Email (SMTP) - Fallback before dynamic app_smtp
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BSofts School <no-reply@bsofts-school.com>"
